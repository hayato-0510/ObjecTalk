OPENAI_API_KEY=
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
PORT=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=

# External tools (get_weather via Open-Meteo, web_search via the OpenAI Responses API).
# web_search reuses OPENAI_API_KEY. Defaults shown; both optional.
OPENAI_WEB_SEARCH_MODEL=gpt-4o-mini
TOOL_INVOKE_TIMEOUT_MS=8000
OPENAI_REALTIME_FEMININE_VOICES=marin,coral,shimmer
OPENAI_REALTIME_MASCULINE_VOICES=cedar,ash,echo
OPENAI_REALTIME_NEUTRAL_VOICES=alloy,sage,verse,ballad

# Open-campus exhibition: daily cap on OpenAI Realtime minutes across the whole
# deployment. Leave EXHIBITION_DAILY_BUDGET_MINUTES unset for no cap.
EXHIBITION_DAILY_BUDGET_MINUTES=
EXHIBITION_MINUTES_PER_SESSION=3
